# Server
PORT=5000
NODE_ENV=development

# JWT
Jwt_secret=super-secret-key-change-me

# Cloudinary
Cloud_Name=your-cloud-name
Cloud_Api=your-api-key
Cloud_Secret=your-api-secret

# PostgreSQL connection (use either discrete values or DATABASE_URL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=spotify
POSTGRES_PASSWORD=spotify_password
POSTGRES_DATABASE=spotify_db
# DATABASE_URL=postgres://spotify:spotify_password@localhost:5432/spotify_db

# Set to "true" to enable SSL (defaults to disabled)
POSTGRES_SSL=false
